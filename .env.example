# Template for local configuration. Copy to ".env" and fill in real values.
# ".env" is git-ignored; this example file is safe to commit.
DB_URL=jdbc:postgresql://localhost:5432/rightpath
DB_USERNAME=postgres
DB_PASSWORD=change-me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000
# Initial admin account, created on first startup if it does not exist.
# Leave ADMIN_PASSWORD empty to skip creating an admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
